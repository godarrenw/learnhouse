# 先进智造学堂（LearnHouse@NAS）环境变量模板
#
# 键名与顺序对齐生产 /volume1/docker/learnhouse/.env（2026-09-10 抄录）。
# **生产的真实密钥值一律不进本仓库**，这里只有键名、非敏感值与占位。
# 用法：在 NAS 上 cp .env.example .env 后逐项填写；已在跑的部署不要覆盖现有 .env。
#
# 留空 = 必须自己填（密钥类）。有值 = 生产实际在用的非敏感配置，可直接沿用。

# =============================================================================
# Domain & Hosting
# =============================================================================
LEARNHOUSE_DOMAIN=learn.sysu-sam.com
HTTP_PORT=8088
LEARNHOUSE_TENANCY=single

# =============================================================================
# Frontend (NEXT_PUBLIC_*) —— 由镜像内 server-wrapper.js 在运行时注入
# =============================================================================
NEXT_PUBLIC_LEARNHOUSE_API_URL=https://learn.sysu-sam.com/api/v1/
NEXT_PUBLIC_LEARNHOUSE_BACKEND_URL=https://learn.sysu-sam.com/
NEXT_PUBLIC_LEARNHOUSE_DOMAIN=learn.sysu-sam.com
NEXT_PUBLIC_LEARNHOUSE_TOP_DOMAIN=sysu-sam.com
NEXT_PUBLIC_LEARNHOUSE_MULTI_ORG=False
NEXT_PUBLIC_LEARNHOUSE_DEFAULT_ORG=default
NEXT_PUBLIC_LEARNHOUSE_HTTPS=True

# =============================================================================
# NextAuth
#   openssl rand -hex 32
# =============================================================================
NEXTAUTH_URL=https://learn.sysu-sam.com
NEXTAUTH_SECRET=

# =============================================================================
# Backend
#   连接串里的用户名/密码要与下面 POSTGRES_* 一致。
# =============================================================================
LEARNHOUSE_SQL_CONNECTION_STRING=postgresql://learnhouse:<POSTGRES_PASSWORD>@db:5432/learnhouse
LEARNHOUSE_REDIS_CONNECTION_STRING=redis://redis:6379/learnhouse
LEARNHOUSE_PORT=9000
LEARNHOUSE_ALLOWED_ORIGINS=https://learn.sysu-sam.com

# =============================================================================
# Security
#   JWT 密钥至少 32 字符，config.py 会硬校验；换掉它等于让所有已签发 token 失效。
#   INITIAL_ADMIN_* 只在「空库首启」时用于建管理员，之后不再生效。
# =============================================================================
LEARNHOUSE_AUTH_JWT_SECRET_KEY=
LEARNHOUSE_INITIAL_ADMIN_EMAIL=
LEARNHOUSE_INITIAL_ADMIN_PASSWORD=
LEARNHOUSE_INITIAL_ORG_NAME=Default Organization
LEARNHOUSE_INITIAL_ORG_SLUG=default

# =============================================================================
# Collaboration Server（/collab 白板协作，需 WebSocket）
# =============================================================================
COLLAB_INTERNAL_KEY=
COLLAB_TRUST_PROXY=true
LEARNHOUSE_REDIS_URL=redis://redis:6379
NEXT_PUBLIC_COLLAB_URL=wss://learn.sysu-sam.com/collab

# =============================================================================
# General
# =============================================================================
LEARNHOUSE_DEVELOPMENT_MODE=False
LEARNHOUSE_LOGFIRE_ENABLED=False
LEARNHOUSE_CONTENT_DELIVERY_TYPE=filesystem

# =============================================================================
# Database
#   与 compose 里 db 服务的 POSTGRES_* 是同一组值。
# =============================================================================
POSTGRES_USER=learnhouse
POSTGRES_PASSWORD=
POSTGRES_DB=learnhouse

# =============================================================================
# AI —— 走硅基流动（OpenAI 兼容）
#   本分支的 generator.py 补丁让生图也复用这里的 API_KEY / BASE_URL，
#   不再需要 LEARNHOUSE_GEMINI_API_KEY。生图模型名可用
#   LEARNHOUSE_AI_IMAGE_MODEL / LEARNHOUSE_AI_IMAGE_EDIT_MODEL 覆盖，
#   默认 Qwen/Qwen-Image 与 Qwen/Qwen-Image-Edit-2509。
# =============================================================================
LEARNHOUSE_IS_AI_ENABLED=True
LEARNHOUSE_AI_PROVIDER=openai
LEARNHOUSE_AI_BASE_URL=https://api.siliconflow.cn/v1
LEARNHOUSE_AI_API_KEY=
LEARNHOUSE_AI_MODEL_FAST=deepseek-ai/DeepSeek-V4-Flash
LEARNHOUSE_AI_MODEL_STANDARD=deepseek-ai/DeepSeek-V4-Flash
LEARNHOUSE_AI_MODEL_PRO=deepseek-ai/DeepSeek-V4-Flash
LEARNHOUSE_AI_EMBEDDING_PROVIDER=openai
LEARNHOUSE_AI_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
LEARNHOUSE_AI_EMBEDDING_DIMENSIONS=768
# --- SYSU-SAM: 教学工具 · 作业工具的 AI 出题（OpenAI 兼容端点）---
# 不填就只有 AI 出题这一个功能不可用（接口返回 503），其它作业工具照常。
LEARNHOUSE_EXT_LLM_BASE_URL=
LEARNHOUSE_EXT_LLM_API_KEY=
LEARNHOUSE_EXT_LLM_MODEL=
# --- /SYSU-SAM ---

LEARNHOUSE_SSL=false
LEARNHOUSE_PGBOUNCER=true

# =============================================================================
# Email —— 走 Resend，发信域名需先在 Resend 验证
# =============================================================================
LEARNHOUSE_EMAIL_PROVIDER=resend
LEARNHOUSE_SYSTEM_EMAIL_ADDRESS=
LEARNHOUSE_SYSTEM_EMAIL_SENDER_NAME=先进智造学堂
LEARNHOUSE_RESEND_API_KEY=
LEARNHOUSE_FRONTEND_DOMAIN=learn.sysu-sam.com
LEARNHOUSE_SITE_NAME=先进智造学堂
LEARNHOUSE_SITE_DESCRIPTION=中山大学先进制造学院 · 先进智造实验室

# =============================================================================
# 分析看板（自托管未配置，全部 /analytics/dashboard/* 返回 503，属预期）
# =============================================================================
# LEARNHOUSE_TINYBIRD_API_URL=
# LEARNHOUSE_TINYBIRD_INGEST_TOKEN=
# LEARNHOUSE_TINYBIRD_READ_TOKEN=

# =============================================================================
# Cloudflare Tunnel —— 【备用，当前不需要填】
#
# 学堂的隧道**复用 NAS 上已有的 SZ_NAS**（id f8b7e1c1-6077-4fc4-9a55-c4bc1678d325，
# chat / wandb / overleaf 都走它），只是给它的 ingress 加了一条
# learn.sysu-sam.com -> http://172.25.5.162:8088。那个 cloudflared 容器不在本
# compose 里，也不读这个 .env，所以**这一项留空即可**。
#
# 只有将来要起一条独立于 SZ_NAS 的隧道（compose 里那段被注释掉的 cloudflared 服务）
# 才需要填：Zero Trust -> Networks -> Tunnels 建隧道后复制的连接器 token。
# 那时它等于隧道的凭据，泄露后到控制台 Refresh token 作废旧的。
#
# 完整上线步骤见 deploy/TUNNEL_RUNBOOK.md，CF 侧脚本见 deploy/cf/。
# =============================================================================
CF_TUNNEL_TOKEN=

# =============================================================================
# 内部媒体域名（阶段三前端提示用；阶段一、二用不到，留空即可）
#
# NEXT_PUBLIC_LEARNHOUSE_HEAVY_MEDIA_URL —— 只给「校外友好提示」的探测用：
#   前端 useCampusNetwork hook 对 <这个地址>/api/v1/health 做一次 no-cors HEAD，
#   探得通 = 用户在校园网，探不通就在视频/PDF 位置显示「仅限校园网观看」。
#   留空时 hook 不探测、不显示任何提示，行为与上游完全一致。
#   例：https://media.sysu-sam.com
#
# ⚠️ 不要把它和 NEXT_PUBLIC_LEARNHOUSE_MEDIA_URL 搞混。后者是上游自带的
#   「所有 /content/ 一刀切」开关，**绝对不要设**：设了以后课程封面、用户头像、
#   机构 logo、图片块会全部指向 media 域名，校外用户满页图片裂开。
#   本方案的媒体分流是在 nginx 里按路径做 302，不动这个变量。
# =============================================================================
# NEXT_PUBLIC_LEARNHOUSE_HEAVY_MEDIA_URL=
